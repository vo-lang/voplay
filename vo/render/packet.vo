package render

import (
	"github.com/vo-lang/voplay"
)

const (
	AssetMesh3d uint32 = 2
	AssetMaterial3d uint32 = 3
	AssetSkinPalette3d uint32 = 4
	AssetHeightmap3d uint32 = 5
	AssetTexture2d uint32 = 6
)

type SnapshotObject struct {
	Entity voplay.Handle
	Bytes []byte
}

const (
	TransactionSpawn uint32 = 1
	TransactionDespawn uint32 = 2
	TransactionUpsert uint32 = 3
)

type TransactionOp struct {
	Kind uint32
	Entity voplay.Handle
	Bytes []byte
}

type AssetAck struct {
	Kind uint32
	Asset uint64
	Revision uint64
	RequiredControlRevision uint64
	SourceSimulationRevision uint64
}

// EncodeSnapshotPacket publishes a complete retained render world. Object bytes
// may contain a retained 3D object or one of the retained 2D object formats.
func EncodeSnapshotPacket(engine voplay.EngineRef, channelEpoch uint64,
	commitId uint64, revision uint64, requiredControlRevision uint64,
	sourceSimulationRevision uint64, objects []SnapshotObject) ([]byte, bool) {
	if !engine.Engine.Valid() || channelEpoch == 0 || commitId == 0 || revision == 0 ||
		len(objects) > 1000000 {
		return nil, false
	}
	payload := appendRenderU32(nil, uint32(len(objects)))
	var previous voplay.Handle
	for index, object := range objects {
		if !object.Entity.Valid() || len(object.Bytes) == 0 || len(object.Bytes) > 4194304 {
			return nil, false
		}
		if index != 0 && (object.Entity.Index < previous.Index ||
			object.Entity.Index == previous.Index &&
				object.Entity.Generation <= previous.Generation) {
			return nil, false
		}
		previous = object.Entity
		payload = appendRenderU32(payload, object.Entity.Index)
		payload = appendRenderU32(payload, object.Entity.Generation)
		payload = appendRenderU32(payload, uint32(len(object.Bytes)))
		payload = append(payload, object.Bytes...)
		if len(payload)+80 > 67108864 {
			return nil, false
		}
	}
	return encodeRenderFrameworkPacket(3, engine, channelEpoch, commitId, 0, revision,
		requiredControlRevision, sourceSimulationRevision, 0, payload)
}

// EncodeTransactionPacket publishes an incremental retained-world update against
// an acknowledged base revision. Spawn and Upsert carry object bytes; Despawn
// only carries the entity identity.
func EncodeTransactionPacket(engine voplay.EngineRef, channelEpoch uint64,
	commitId uint64, baseRevision uint64, newRevision uint64,
	requiredControlRevision uint64, sourceSimulationRevision uint64,
	ops []TransactionOp) ([]byte, bool) {
	if !engine.Engine.Valid() || channelEpoch == 0 || commitId == 0 ||
		baseRevision == 0 || newRevision != baseRevision + 1 || len(ops) > 131072 {
		return nil, false
	}
	payload := appendRenderU32(nil, uint32(len(ops)))
	for _, op := range ops {
		if !op.Entity.Valid() || op.Kind < TransactionSpawn || op.Kind > TransactionUpsert ||
			op.Kind == TransactionDespawn && len(op.Bytes) != 0 ||
			op.Kind != TransactionDespawn && (len(op.Bytes) == 0 || len(op.Bytes) > 4194304) {
			return nil, false
		}
		payload = append(payload, byte(op.Kind))
		payload = appendRenderU32(payload, op.Entity.Index)
		payload = appendRenderU32(payload, op.Entity.Generation)
		if op.Kind != TransactionDespawn {
			payload = appendRenderU32(payload, uint32(len(op.Bytes)))
			payload = append(payload, op.Bytes...)
		}
		if len(payload)+80 > 67108864 {
			return nil, false
		}
	}
	return encodeRenderFrameworkPacket(1, engine, channelEpoch, commitId, baseRevision, newRevision,
		requiredControlRevision, sourceSimulationRevision, 0, payload)
}

// EncodeAssetPacket stages an immutable renderer-owned asset revision.
func EncodeAssetPacket(engine voplay.EngineRef, channelEpoch uint64, kind uint32,
	asset uint64, revision uint64, requiredControlRevision uint64,
	sourceSimulationRevision uint64, descriptor []byte) ([]byte, bool) {
	if !engine.Engine.Valid() || channelEpoch == 0 || kind < AssetMesh3d ||
		kind > AssetTexture2d || asset == 0 || revision == 0 ||
		len(descriptor) == 0 || len(descriptor) > 4194304 {
		return nil, false
	}
	payload := []byte{'V', 'R', 'A', '1', 1}
	payload = appendRenderU32(payload, kind)
	payload = appendRenderU64(payload, asset)
	payload = appendRenderU64(payload, revision)
	payload = appendRenderU32(payload, uint32(len(descriptor)))
	payload = append(payload, descriptor...)
	return encodeRenderFrameworkPacket(37, engine, channelEpoch, asset, 0, revision,
		requiredControlRevision, sourceSimulationRevision, 0, payload)
}

func DecodeAssetAck(engine voplay.EngineRef, packet []byte) (AssetAck, bool) {
	if len(packet) != 84 || uint16(packet[0])|uint16(packet[1])<<8 != 38 ||
		readRenderPacketU32(packet, 4) != engine.Engine.Index ||
		readRenderPacketU32(packet, 8) != engine.Engine.Generation ||
		readRenderPacketU64(packet, 12) == 0 || readRenderPacketU64(packet, 20) == 0 ||
		readRenderPacketU64(packet, 36) == 0 || readRenderPacketU32(packet, 76) != 4 {
		return AssetAck{}, false
	}
	ack := AssetAck{
		Kind: readRenderPacketU32(packet, 80),
		Asset: readRenderPacketU64(packet, 20),
		Revision: readRenderPacketU64(packet, 36),
		RequiredControlRevision: readRenderPacketU64(packet, 44),
		SourceSimulationRevision: readRenderPacketU64(packet, 52),
	}
	return ack, ack.Kind >= AssetMesh3d && ack.Kind <= AssetTexture2d
}

func encodeRenderFrameworkPacket(kind uint16, engine voplay.EngineRef,
	channelEpoch uint64, commitId uint64, baseRevision uint64, newRevision uint64,
	requiredControlRevision uint64, sourceSimulationRevision uint64, sequence uint64,
	payload []byte) ([]byte, bool) {
	if !engine.Engine.Valid() || channelEpoch == 0 || len(payload)+80 > 67108864 {
		return nil, false
	}
	packet := make([]byte, 80)
	packet[0] = byte(kind)
	packet[1] = byte(kind >> 8)
	putRenderU32(packet, 4, engine.Engine.Index)
	putRenderU32(packet, 8, engine.Engine.Generation)
	putRenderU64(packet, 12, channelEpoch)
	putRenderU64(packet, 20, commitId)
	putRenderU64(packet, 28, baseRevision)
	putRenderU64(packet, 36, newRevision)
	putRenderU64(packet, 44, requiredControlRevision)
	putRenderU64(packet, 52, sourceSimulationRevision)
	putRenderU64(packet, 60, sequence)
	putRenderU32(packet, 76, uint32(len(payload)))
	return append(packet, payload...), true
}

func putRenderU32(bytes []byte, offset int, value uint32) {
	bytes[offset] = byte(value)
	bytes[offset+1] = byte(value >> 8)
	bytes[offset+2] = byte(value >> 16)
	bytes[offset+3] = byte(value >> 24)
}

func putRenderU64(bytes []byte, offset int, value uint64) {
	bytes[offset] = byte(value)
	bytes[offset+1] = byte(value >> 8)
	bytes[offset+2] = byte(value >> 16)
	bytes[offset+3] = byte(value >> 24)
	bytes[offset+4] = byte(value >> 32)
	bytes[offset+5] = byte(value >> 40)
	bytes[offset+6] = byte(value >> 48)
	bytes[offset+7] = byte(value >> 56)
}

func readRenderPacketU32(bytes []byte, offset int) uint32 {
	return uint32(bytes[offset]) | uint32(bytes[offset+1]) << 8 |
		uint32(bytes[offset+2]) << 16 | uint32(bytes[offset+3]) << 24
}

func readRenderPacketU64(bytes []byte, offset int) uint64 {
	return uint64(readRenderPacketU32(bytes, offset)) |
		uint64(readRenderPacketU32(bytes, offset+4)) << 32
}
